<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:gml="http://www.opengis.net/gml/3.2" elementFormDefault="qualified">
    <xsd:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="https://schemas.opengis.net/gml/3.2.1/gml.xsd"/>
    <xsd:complexType name="abcType">
        <xsd:complexContent>
            <xsd:extension base="gml:AbstractFeatureType">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="0" name="a" nillable="true" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="b" nillable="false" type="xsd:decimal"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="c" nillable="false" type="xsd:decimal"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="GEOM" nillable="true" type="gml:MultiCurvePropertyType"/>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="abc" substitutionGroup="gml:AbstractFeature" type="abcType"/>
</xsd:schema>